# Aegis-rToken Configuration Template
# Copy to .env and fill in values. NEVER commit .env to version control.

# Monitored Asset & Trading Parameters (Discovered Bitget rToken)
TARGET_ASSET=RAAPLUSDT
CATEGORY=SPOT
MARKET_DATA_SOURCE=Bitget-UTA-v3
EXECUTION_CATEGORY=SPOT
TRADING_MODE=demo
ENABLE_DEMO_ORDER=false
ENABLE_REAL_DEMO_ORDER=false

# Bitget Qwen / LLM Sentinel Configuration (Bitget Hackathon Provider)
BITGET_QWEN_API_KEY=your_bitget_qwen_api_key_here
MODEL_PROVIDER=bitget-qwen
MODEL_PROVIDER_NAME=Bitget Qwen
LLM_BASE_URL=https://hackathon.bitgetops.com/v1
LLM_MODEL=qwen3.8-max
WIRE_API=responses

# Risk Engine Thresholds (Deterministic Gates)
MAX_SPREAD_PERCENT=0.8
MIN_CONFIDENCE_SCORE=0.75
MAX_ALLOCATION_USD=500
STALE_DATA_TIMEOUT_SECONDS=10
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Bitget API Credentials (Optional in paper mode; needed for live bgc CLI execution)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Telemetry and API Server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
